# Roger configuration. Copy to .env (next to where you run `roger`, or to ~/.roger/.env).
# Only the first two lines are required; everything else has a sensible default.

# ---------------------------------------------------------------- required
# https://app.attendee.dev -> Settings -> API keys. Runs the participant that joins the call.
ATTENDEE_API_KEY=

# https://platform.openai.com/api-keys. One key covers hearing, speaking, thinking and web search.
OPENAI_API_KEY=

# ---------------------------------------------------------------- who it is
# BOT_NAME=Roger                # the display name in the meeting
# BOT_FIRST_NAME=Roger          # what people call it (default: the first word of BOT_NAME)
# OWNER_NAME=                   # "Alice" -> "Alice's AI assistant"; empty -> "the team's"
# WAKE_WORDS=roger,rodger,rojer # how the name tends to come through in speech
# GREETING=                     # set to make it announce itself on joining; empty means it waits to be spoken to

# ---------------------------------------------------------------- what it knows
# Attach the coding sessions you have been working in and it arrives knowing what they know. The session
# files are READ as text to write a briefing. Neither Claude Code nor Codex is ever run, nothing is billed
# to them, and your real sessions are never resumed or written to. Both can be attached at once.
# Run `roger sessions <project-dir>` to see what is available.
# CLAUDE_SESSION_ID=            # from ~/.claude/projects/...
# CODEX_SESSION_ID=             # from ~/.codex/sessions/...
# PROJECT_DIR=                  # the project folder the briefing and the repo tools look at
# REPO_TOOLS=1                  # let it search and read files under PROJECT_DIR (read-only)
# WEB_SEARCH=1                  # let it search the web for anything outside the project

# ---------------------------------------------------------------- models
# FAST_MODEL=gpt-5.6-luna       # the backend GPT-Live delegates the thinking to
# BRIEFING_MODEL=gpt-5.6-luna   # turns your sessions into the briefing, once at startup
# BACKEND_EFFORT=none           # reasoning effort: none | low | medium | high. none is the fastest.

# ---------------------------------------------------------------- voice
# LIVE_MODEL=gpt-live-1
# VOICE=cedar                   # cedar (male) and marin (female) are the flagship pair. Others: alloy, ash,
#                               # ballad, beacon, bossa, cinder, coral, delta, echo, gleam, meridian, quartz,
#                               # ripple, sage, shimmer, stone, tempo, verse, vesper, willow
# LANGUAGE=en
# AUDIO_RATE=24000              # 16000 or 24000. 24000 is GPT-Live's native rate and needs no resampling.
# OUTPUT_BUFFER_MS=500          # audio held back at the start of a turn. GPT-Live's delivery stalls for up to
#                               # ~360 ms at times, and a shorter buffer is heard as distortion. Raise if you
#                               # still hear it; lower (to ~250) for a snappier start.
# ECHO_SUPPRESS=0               # 1 only if it ever answers itself; it costs you interruptions

# ---------------------------------------------------------------- plumbing
# PORT=8787
# PUBLIC_URL=                   # empty: a Cloudflare quick tunnel is started for you (needs cloudflared)
# PER_PARTICIPANT_AUDIO=1       # per-speaker streams, so the transcript has names instead of "Someone"
# ATTENDEE_BASE=https://app.attendee.dev/api/v1
#                               # Attendee is source-available (Elastic License 2.0) and can be self-hosted:
#                               # point this at your own instance, e.g. http://localhost:8000/api/v1, and the
#                               # hosted account is no longer involved. See README, "Self-hosting Attendee".
# ATTENDEE_USE_LOGIN=0          # 1: join Teams/Meet with a signed-in bot account (Attendee > Bot Logins)
# ATTENDEE_LOGIN_GROUP=         # which bot-login group to use (default: the oldest)
# ROGER_STATE_DIR=~/.roger      # logs, the bot id, the briefing cache
