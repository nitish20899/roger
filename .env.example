# Roger configuration. Copy this file to .env (next to where you run `roger`, or to ~/.roger/.env) and fill in the keys.
# Only the three sections marked REQUIRED are needed; everything else has sensible defaults.

# ---------------------------------------------------------------- REQUIRED: the meeting bot
# https://app.attendee.dev  ->  sign up (email or Google)  ->  Settings  ->  API keys
# Attendee runs the participant that joins Google Meet / Microsoft Teams / Zoom. Free hours to start, then hourly.
ATTENDEE_API_KEY=

# ---------------------------------------------------------------- REQUIRED: hearing and voice
# https://elevenlabs.io  ->  profile  ->  API keys
# Used for both transcription (Scribe v2 Realtime) and speech (Flash v2.5). Starter plan or above recommended.
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------- REQUIRED: one fast model for spoken replies
# Either key works. If both are set, FAST_PROVIDER picks (default: openai).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# FAST_PROVIDER=openai                 # openai | anthropic
# FAST_MODEL=gpt-4.1-mini              # default: gpt-4.1-mini (openai) or claude-haiku-4-5 (anthropic)
# CLASSIFIER_MODEL=gpt-4.1-mini        # "is this for me?" classifier; gpt-5.4-mini also works well (same provider as FAST_PROVIDER)

# ---------------------------------------------------------------- persona
# BOT_NAME=Roger                       # display name in the meeting
# BOT_FIRST_NAME=Roger                 # what people call it (default: first word of BOT_NAME)
# OWNER_NAME=                          # "Alice" -> it introduces itself as Alice's AI assistant; empty -> the team's
# WAKE_WORDS=roger,rodger,rojer        # how the transcriber tends to hear the name (default: the first name + known mishearings)
# ATTENTION_WINDOW_S=30                # after it is addressed or speaks, follow-ups need no name for this long
# GREETING=                            # custom spoken greeting when it joins

# ---------------------------------------------------------------- voice
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # any voice id from your ElevenLabs voice library ("George" by default)
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2_realtime
# STT_SILENCE_S=0.6                    # silence that ends a person's turn
# VOICE_STABILITY=0.6                  # 0..1, lower = more expressive
# VOICE_STYLE=0.0                      # 0..1, style exaggeration
# LANGUAGE=en

# ---------------------------------------------------------------- the deep brain: Claude Code (optional)
# Attach one of your Claude Code sessions so Roger answers with everything that session knows, or point it at a
# project folder for a fresh read-only session. `roger sessions <project-dir>` lists session ids.
# Per meeting you can instead pass `roger run <url> --session <id|latest> --project <dir>`; flags win over these.
# CLAUDE_SESSION_ID=
# PROJECT_DIR=                         # the session's project folder (or any repo for a fresh session)
# DEEP_MODEL=sonnet                   # alias (sonnet | opus) or a full model id. Use an alias if your project routes Claude Code through a gateway (Bedrock, Vertex, Databricks): it maps through ANTHROPIC_DEFAULT_*_MODEL
# DEEP_AUTH=subscription               # subscription: your Claude Code login | api: bill ANTHROPIC_API_KEY
# DEEP_AGENT=auto                      # auto: on when CLAUDE_SESSION_ID or PROJECT_DIR is set | 1 | 0

# ---------------------------------------------------------------- visuals: the orb webcam
# ORB=1                                # animated orb as the bot's webcam (Attendee voice-agent mode)
# ORB_COLORS=#FFC7A1,#DF5B37           # two gradient colors; try #CADCFC,#A0B9D1 (blue) or #F6E7D8,#E0CFC2 (cream)
# ORB_BG=#0a0d10                       # page background behind the orb
# ORB_SIZE=520                         # orb diameter in px on a 1280x720 tile
# AUDIO_OUT=page                       # page: the orb page plays the voice (lip-sync) | ws: send audio frames instead

# ---------------------------------------------------------------- plumbing
# PORT=8787
# PUBLIC_URL=                          # empty: a Cloudflare quick tunnel is started for you (needs cloudflared)
# ATTENDEE_BASE=https://app.attendee.dev/api/v1
# ATTENDEE_USE_LOGIN=0                 # 1: join Teams / Meet with a signed-in bot account set up in Attendee (Settings > Bot Logins)
# ATTENDEE_LOGIN_GROUP=                # which bot-login group to use (default: the oldest one)
# PER_PARTICIPANT_AUDIO=1              # per-speaker streams so the transcript has names
# BARGE_IN_ENERGY=0                    # 1 = also stop talking on loud audio (faster, but can trip on its own voice)
# ROGER_STATE_DIR=~/.roger             # logs, bot id, briefing cache
